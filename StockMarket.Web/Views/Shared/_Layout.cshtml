@{
  bool IsActive(string controller) =>
      string.Equals((string?)ViewContext.RouteData.Values["controller"], controller,
                    StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <script>
      // Runs before the stylesheets so the page never flashes the wrong theme or sidebar state
      (() => {
          const r = document.documentElement;
          r.dataset.bsTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          let saved;
          try { saved = localStorage.getItem("sidebar"); } catch { }
          const desktop = matchMedia("(min-width: 992px)").matches;
          r.dataset.sidebar = desktop && saved !== "closed" ? "open" : "closed";
      })();
  </script>
  <script type="importmap"></script>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
  <a class="visually-hidden-focusable" href="#main">Skip to content</a>

  <header class="app-header navbar bg-body-secondary border-bottom sticky-top px-3">
    <div class="d-flex align-items-center gap-3">
      <button type="button" id="sidebar-toggle" class="btn btn-outline-secondary btn-sm"
              aria-controls="app-sidebar" aria-expanded="true" aria-label="Toggle navigation">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <a class="navbar-brand m-0 fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">StockMarket</a>
    </div>
  </header>

  <div class="app-body">
    <nav id="app-sidebar" class="app-sidebar" aria-label="Main">
      <ul class="nav nav-pills flex-column gap-1">
        <li class="nav-item">
          <a class="nav-link @(IsActive("Stocks") ? "active" : "")"
             aria-current="@(IsActive("Stocks") ? "page" : null)"
             asp-controller="Stocks" asp-action="Index">Stock search</a>
        </li>
        <li class="nav-item">
          <a class="nav-link @(IsActive("Watchlists") ? "active" : "")"
             aria-current="@(IsActive("Watchlists") ? "page" : null)"
             asp-controller="Watchlists" asp-action="Index">Watchlists</a>
        </li>
        <li class="nav-item">
          <a class="nav-link @(IsActive("Statements") ? "active" : "")"
             aria-current="@(IsActive("Statements") ? "page" : null)"
             asp-controller="Statements" asp-action="Index">Compare financials</a>
        </li>
        <li class="nav-item">
          <a class="nav-link @(IsActive("Portfolio") ? "active" : "")"
             aria-current="@(IsActive("Portfolio") ? "page" : null)"
             asp-controller="Portfolio" asp-action="Index">Portfolio</a>
        </li>
        <li class="nav-item">
          <a class="nav-link @(IsActive("Economy") ? "active" : "")"
             aria-current="@(IsActive("Economy") ? "page" : null)"
             asp-controller="Economy" asp-action="Index">Economic dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link @(IsActive("Trading") ? "active" : "")"
             aria-current="@(IsActive("Trading") ? "page" : null)"
             asp-controller="Trading" asp-action="Index">Paper trading</a>
        </li>
      </ul>
    </nav>

    <div class="app-backdrop" data-sidebar-close></div>

    <div class="app-main">
      <main id="main" tabindex="-1" class="container-fluid py-3">
        @RenderBody()
      </main>
      <footer class="app-footer border-top bg-body-secondary text-body-secondary small px-3 py-3">
        &copy; @DateTime.Now.Year StockMarket &middot; Market data may be delayed
      </footer>
    </div>
  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  <script src="~/js/layout.js" asp-append-version="true" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
