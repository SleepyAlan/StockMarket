@{
  bool IsActive(string controller) =>
      string.Equals((string?)ViewContext.RouteData.Values["controller"], controller,
                    StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <script>
      // Runs before the stylesheets so the page never flashes the wrong theme or sidebar state
      (() => {
          const r = document.documentElement;
          r.dataset.bsTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          let saved;
          try { saved = localStorage.getItem("sidebar"); } catch { }
          const desktop = matchMedia("(min-width: 992px)").matches;
          r.dataset.sidebar = desktop && saved !== "closed" ? "open" : "closed";
      })();
  </script>
  <script type="importmap"></script>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="icon" href="~/favicon.ico" sizes="48x48" />
  <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
  <meta name="theme-color" content="#2753C9" />
</head>
<body class="d-flex flex-column min-vh-100">
  <a class="visually-hidden-focusable" href="#main">Skip to content</a>

  @* Header *@
  <header class="app-header navbar bg-body-secondary border-bottom sticky-top px-3">
    <div class="d-flex align-items-center gap-3">
      <button type="button" id="sidebar-toggle" class="nav-toggle"
              aria-controls="app-sidebar" aria-expanded="true" aria-label="Toggle navigation">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
      <a class="navbar-brand m-0 fw-semibold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
        <img src="~/favicon.svg" width="28" height="28" alt="" class="me-2" />
        <span>StockMarket</span>
      </a>
    </div>
  </header>

  <div class="app-body">
    @* Sidebar *@
    <div class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="app-sidebar" aria-labelledby="app-sidebar-label">
      <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="app-sidebar-label">Menu</h5>
        <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#app-sidebar" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <nav aria-label="Main">
          <ul class="nav nav-pills flex-column gap-1">
            <li class="nav-item">
              <a class="nav-link @(IsActive("Stocks") ? "active" : "")"
                 aria-current="@(IsActive("Stocks") ? "page" : null)"
                 asp-controller="Stocks" asp-action="Index">Stock search</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @(IsActive("Watchlists") ? "active" : "")"
                 aria-current="@(IsActive("Watchlists") ? "page" : null)"
                 asp-controller="Watchlists" asp-action="Index">Watchlists</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @(IsActive("placeholder") ? "active" : "")"
                 aria-current="@(IsActive("placeholder") ? "page" : null)"
                 asp-controller="placeholder" asp-action="placeholder">PlaceHolder</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="app-main">

      @* Main content *@
      <main id="main" tabindex="-1" class="container-fluid py-3">
        @RenderBody()
      </main>

      @* Footer *@
      <footer class="app-footer border-top bg-body-secondary text-body-secondary small px-3 py-3">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-6">
              &copy; @DateTime.Now.Year StockMarket &middot; Market data may be delayed
            </div>
            <div class="col-6 text-end">
              <a href="https://github.com/SleepyAlan/StockMarket" class="text-dark text-decoration-none" target="_blank" rel="noopener noreferrer" aria-label="View profile on GitHub">
                <svg height="24" width="24" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </footer>

    </div>
  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  <script src="~/js/layout.js" asp-append-version="true" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
